# ============================================================
# Agentic Financial Research System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=financial_documents

# --- FastAPI ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
SECRET_KEY=change-me-in-production

# --- Document Processing ---
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Agent Settings ---
MAX_ITERATIONS=10
VERBOSE=false

# --- RAGAs Evaluation ---
RAGAS_EVAL_ENABLED=true
